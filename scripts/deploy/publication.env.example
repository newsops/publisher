# Optional public publication-worker settings; not an admin/server environment.
# Copy only after choosing and reviewing the comment/verification providers.
COMMENTS_PUBLIC_ORIGIN=https://comments.example.com
# Exact true/false only; absent defaults to read-only, invalid/empty fails.
COMMENTS_SUBMISSION_ENABLED=true
HUMAN_VERIFICATION_SITE_KEY=replace-with-public-site-key
HUMAN_VERIFICATION_SCRIPT_URL=https://verification.example.com/widget.js
HUMAN_VERIFICATION_GLOBAL=verification
HUMAN_VERIFICATION_FRAME_ORIGINS='["https://frames.example.com"]'
HUMAN_VERIFICATION_CONNECT_ORIGINS='["https://verification.example.com"]'
# Exact origins only. Both arrays are explicit; [] means no such capability.
# Never put HUMAN_VERIFICATION_SECRET or private provider credentials here.
