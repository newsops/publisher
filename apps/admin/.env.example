ADMIN_PUBLIC_ORIGIN=https://admin.publisher.com
ADMIN_PUBLISHERS=publisher@example.com
DATABASE_URL=postgresql://admin_app:replace-me@localhost:5432/publisher_admin
OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=publisher-admin
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_EMAIL_CLAIM=email
OIDC_TOKEN_HEADER=authorization
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=publisher-content
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
ADMIN_DEV_TOKEN=local-only-token
ADMIN_AUTOMATION_KEYS='[{"id":"claude","role":"publisher","sha256":"replace-with-64-char-sha256"}]'
