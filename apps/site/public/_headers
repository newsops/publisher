# Portable static-host cache and security policy.
# Only content-addressed paths are immutable. Stable URLs always revalidate.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

/theme-runtime/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/data/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/theme-runtime/current.css
  Cache-Control: public, max-age=0, must-revalidate

/.well-known/publisher/*
  Cache-Control: public, max-age=0, must-revalidate

/data/comments/*
  Cache-Control: public, max-age=0, must-revalidate

/search-index.json
  Cache-Control: public, max-age=0, must-revalidate

/site-runtime/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'
